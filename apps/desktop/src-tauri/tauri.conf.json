{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Studio",
  "version": "0.1.0",
  "identifier": "com.studystudio.app",
  "build": {
    "beforeDevCommand": "bun run --filter @study-studio/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run --filter @study-studio/web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Study Studio - AI 外语学习系统",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

